# ==============================================
# MLX Multilingual-E5-Large API Configuration
# ==============================================

# Server Configuration
HOST=127.0.0.1
PORT=12000

# Model Configuration
MODEL_PATH=./model/multilingual-e5-large
ADAPTER_FILE=

# API Defaults
MAX_TOKENS=2048
TEMPERATURE=1.0
TOP_P=1.0

# Security (Option 1: API Key simple - projet privé)
# Générer une clé sécurisée avec: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-key-here

# Rate Limiting (60 requêtes/heure - strict, mais variable)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=3600  # secondes (1 heure)

# Logging (DEBUG - pour Claude Code et développement)
LOG_LEVEL=DEBUG
LOG_FILE=./logs/server.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ⚠️ IMPORTANT: Ne jamais commiter le fichier .env avec de vraies valeurs !
# Copier ce fichier vers .env et remplacer les valeurs
